{
  "expo": {
    "name": "Volley Lineup",
    "slug": "volley-lineup",
    "version": "11.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "volleylineup",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0D0D0D",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF6B00",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.volleylineup.app"
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "name": "Volley Lineup",
      "themeColor": "#0D0D0D",
      "backgroundColor": "#0D0D0D"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF6B00",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Volley Lineup uses your photos to set profile and player pictures.",
          "cameraPermission": "Volley Lineup uses the camera to take profile and player pictures."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Volley Lineup uses Face ID to unlock confidential player descriptions."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.volleylineup.app"
    }
  }
}
